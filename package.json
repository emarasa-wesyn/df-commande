{
  "name": "df-commandes",
  "version": "1.4.2",
  "private": true,
  "description": "API de devis et de commandes de Delmas & Fournier, maintenue par Néotis",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "test:couverture": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-coverage-include=src/**",
    "test:caracterisation": "node --disable-warning=ExperimentalWarning --test test/caracterisation/*.test.js",
    "test:intersession": "node --disable-warning=ExperimentalWarning --test exercices/intersession/*.js",
    "tva": "node scripts/verifier.js tva",
    "tva:couverture": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-coverage-include=src/devis/** exercices/tva/tva.js",
    "bench": "node --disable-warning=ExperimentalWarning scripts/bench-export.js",
    "doublons": "node exercices/doublons/mesurer.js",
    "arrondi": "node scripts/verifier.js arrondi",
    "arrondi:appli": "node scripts/verifier.js arrondi appli",
    "prix": "node scripts/verifier.js prix",
    "reference": "node scripts/verifier.js reference",
    "devis-du-jour": "node scripts/verifier.js devis-du-jour",
    "recette": "node scripts/verifier.js recette",
    "reprise": "node scripts/verifier.js reprise",
    "intersession": "node scripts/verifier.js intersession",
    "proposition": "eslint exercices/fusion && node --disable-warning=ExperimentalWarning --test exercices/fusion/proposition-tests.js",
    "fusion": "node scripts/verifier.js fusion",
    "anonymat": "node scripts/verifier.js anonymat",
    "chiffrer": "node scripts/chiffrer.js",
    "hook": "node scripts/verifier.js hook",
    "failles": "node scripts/verifier.js failles",
    "consigne": "node scripts/verifier.js consigne",
    "lint": "eslint .",
    "start:local": "node --disable-warning=ExperimentalWarning --env-file=.env src/server.js",
    "prepare": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0"
  }
}
